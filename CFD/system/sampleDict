type surfaces;
libs ("libsampling.so");


setFormat null;

surfaceFormat raw;


formatOptions
{
    ensight
    {
        format  ascii;
    }
}


interpolationScheme cellPoint;


fields
(
    Us
);


surfaces
(
    constantPlane
    {
        type            plane;
        planeType       pointAndNormal;
        pointAndNormalDict
        {
            basePoint       (0 0.006 0);
            normalVector    (0 1 0);
        }
        

    }
);


